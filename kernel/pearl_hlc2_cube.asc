/* Cube emits the raw INT32 products. All Pearl postprocessing runs on the host. */
#include <iostream>
#include <cstdlib>
#include <thread>
#include <vector>
#include "../src/pearl_pipeline.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

#ifndef BASEN
#define BASEN 0
#endif

constexpr int32_t R = PRL_RANK, BN = PEARL_BAND_COLS, KSTEP = PRL_RANK;
constexpr int32_t NFOLD_C = PEARL_FOLDS;
constexpr int32_t MM_M = BN, MM_N = R, MM_K = KSTEP;
constexpr int32_t GRID = PEARL_GRID;

__global__ __cube__ void pearl_hlc2_cube(__gm__ uint8_t* bt, __gm__ uint8_t* at,
    __gm__ uint8_t* part, __gm__ uint8_t* workspace,
    AscendC::tiling::TCubeTiling tiling, int32_t nbands, int32_t gridDim)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<int8_t> aGM, bGM;
    aGM.SetGlobalBuffer((__gm__ int8_t*)bt);
    bGM.SetGlobalBuffer((__gm__ int8_t*)at);
    AscendC::GlobalTensor<int32_t> partG; partG.SetGlobalBuffer((__gm__ int32_t*)part);
    // The input A operand is transposed logically by matmul, not on the host.
    matmul::Matmul<matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>,
                   matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, true>,
                   matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(MM_M, MM_N, MM_K, NFOLD_C * MM_K);
    for (int32_t band = AscendC::GetBlockIdx(); band < nbands; band += gridDim) {
        for (int32_t p = 0; p < NFOLD_C; ++p) {
            const uint64_t tile = (uint64_t)band * NFOLD_C + p;
            mm.SetTensorA(aGM[tile * MM_M * MM_K], false);
            mm.SetTensorB(bGM[(uint64_t)p * MM_K], true);
            mm.IterateAll(partG[tile * PEARL_PART_ELEMS]);
        }
    }
    mm.End();
}

static AscendC::tiling::TCubeTiling GenTiling(platform_ascendc::PlatformAscendC* plat)
{
    AscendC::tiling::TCubeTiling t{};
    matmul_tiling::MultiCoreMatmulTiling api(*plat);
    api.SetDim(1);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, true);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
    api.SetOrgShape(MM_M, MM_N, MM_K, NFOLD_C * MM_K);
    api.SetShape(MM_M, MM_N, MM_K);
    // BASEN=0 uses a full-width L0C tile; smaller tiling trades reuse for capacity.
    const int32_t baseN = (BASEN > 0) ? BASEN : MM_N;
    api.SetFixSplit(MM_M, baseN, KSTEP);
    api.EnableBias(false);
    api.SetBufferSpace(-1, -1, -1);
    if (api.GetTiling(t) == -1) {
        std::cerr << "[pearl-hlc2] tiling failed" << std::endl;
        std::exit(2);
    }
    return t;
}

// Convert B into [band][fold][column][k] tiles for contiguous cube reads.
static void repackBT(const int8_t* B, int8_t* BT, int32_t nbands, int32_t N) {
    const int32_t T = 16;
    std::vector<std::thread> th;
    for (int32_t t = 0; t < T; ++t)
        th.emplace_back([=]() {
            for (int32_t jp = t; jp < nbands; jp += T)
                for (int32_t p = 0; p < NFOLD_C; ++p) {
                    const int8_t* src = B + (size_t)p * MM_K * N + (size_t)jp * MM_M;
                    int8_t* dst = BT + ((size_t)jp * NFOLD_C + p) * MM_M * MM_K;
                    for (int32_t k = 0; k < MM_K; ++k)
                        for (int32_t m = 0; m < MM_M; ++m)
                            dst[(size_t)m * MM_K + k] = src[(size_t)k * N + m];
                }
        });
    for (auto& x : th) x.join();
}

static aclrtStream g_sC = nullptr, g_sB = nullptr;
static AscendC::tiling::TCubeTiling g_tiling;
static uint8_t* g_atD = nullptr;
static uint8_t* g_partD = nullptr;
static uint8_t* g_wsD = nullptr;
static uint8_t* g_btD[2] = {};
static int8_t* g_btH[2] = {};
static int32_t* g_partH[PEARL_PIPE_DEPTH] = {};
static aclrtEvent g_done[PEARL_PIPE_DEPTH] = {};
static size_t g_partBytes = 0, g_btBytes = 0;
static int64_t g_sub = 0, g_fin = 0;
static int g_btLive = 0, g_nbands = 0, g_dev = 0;

static void CheckAcl(aclError e, const char* op)
{
    if (e != ACL_SUCCESS) {
        std::cerr << "[pearl-hlc2] " << op << " failed: " << e << std::endl;
        std::exit(2);
    }
}

extern "C" int pearl_init(int device_id, int nbands)
{
    if (nbands <= 0) return -1;
    aclError e = aclInit(nullptr);
    if (e != ACL_SUCCESS && e != ACL_ERROR_REPEAT_INITIALIZE) return (int)e;
    g_dev = device_id;
    g_nbands = nbands;
    g_btBytes = (size_t)nbands * NFOLD_C * BN * KSTEP;
    g_partBytes = (size_t)nbands * NFOLD_C * PEARL_PART_ELEMS * sizeof(int32_t);
    CheckAcl(aclrtSetDevice(g_dev), "set device");
    CheckAcl(aclrtCreateStream(&g_sC), "create cube stream");
    CheckAcl(aclrtCreateStream(&g_sB), "create B upload stream");
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!plat) return -1;
    g_tiling = GenTiling(plat);
    size_t wsSize = (size_t)plat->GetLibApiWorkSpaceSize();
    CheckAcl(aclrtMalloc((void**)&g_wsD, wsSize, ACL_MEM_MALLOC_HUGE_FIRST), "allocate workspace");
    CheckAcl(aclrtMalloc((void**)&g_atD, R * PRL_K, ACL_MEM_MALLOC_HUGE_FIRST), "allocate A");
    CheckAcl(aclrtMalloc((void**)&g_partD, g_partBytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate cube output");
    for (int s = 0; s < 2; ++s) {
        CheckAcl(aclrtMalloc((void**)&g_btD[s], g_btBytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate B");
    }
    for (int s = 0; s < PEARL_PIPE_DEPTH; ++s) {
        CheckAcl(aclrtMallocHost((void**)&g_partH[s], g_partBytes), "allocate pinned cube output");
        CheckAcl(aclrtCreateEvent(&g_done[s]), "create cube output event");
    }
    std::cout << "[pearl-hlc2] Cube-only dev=" << g_dev << " nbands=" << g_nbands
              << " raw MiB/strip=" << g_partBytes / (1 << 20)
              << " host slots=" << PEARL_PIPE_DEPTH << std::endl;
    return 0;
}

extern "C" void pearl_set_bt_slot(const int8_t* bt_packed, int slot)
{
    CheckAcl(aclrtSetDevice(g_dev), "bind B upload thread");
    CheckAcl(aclrtMemcpyAsync(g_btD[slot], g_btBytes, bt_packed, g_btBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE, g_sB), "upload packed B");
    CheckAcl(aclrtSynchronizeStream(g_sB), "complete B upload");
}

extern "C" void pearl_set_b_slot(const int8_t* B_host, int N, int slot)
{
    CheckAcl(aclrtSetDevice(g_dev), "bind B repack thread");
    if (!g_btH[slot]) {
        CheckAcl(aclrtMallocHost((void**)&g_btH[slot], g_btBytes), "allocate pinned B repack buffer");
    }
    repackBT(B_host, g_btH[slot], g_nbands, N);
    pearl_set_bt_slot(g_btH[slot], slot);
}

extern "C" void pearl_use_b(int slot)
{
    if (slot < 0 || slot >= 2 || g_sub != g_fin) {
        std::cerr << "[pearl-hlc2] use_b requires a valid slot and a drained strip queue" << std::endl;
        std::exit(2);
    }
    g_btLive = slot;
    g_sub = g_fin = 0;
}

extern "C" void pearl_set_b(const int8_t* B_host, int N)
{
    pearl_set_b_slot(B_host, N, 0);
    pearl_use_b(0);
}

extern "C" void pearl_submit_partials(const int8_t* A_host)
{
    if (g_sub - g_fin >= PEARL_PIPE_DEPTH) {
        std::cerr << "[pearl-hlc2] strip queue full" << std::endl;
        std::exit(2);
    }
    const int s = (int)(g_sub % PEARL_PIPE_DEPTH);
    const size_t atBytes = R * PRL_K;
    // The stream orders A upload, matmul and D2H before reuse of device buffers.
    CheckAcl(aclrtMemcpyAsync(g_atD, atBytes, A_host, atBytes,
                              ACL_MEMCPY_HOST_TO_DEVICE, g_sC), "upload A strip");
    const int32_t blocks = g_nbands < GRID ? g_nbands : GRID;
    pearl_hlc2_cube<<<blocks, nullptr, g_sC>>>(g_btD[g_btLive], g_atD, g_partD,
                                               g_wsD, g_tiling, g_nbands, blocks);
    CheckAcl(aclrtMemcpyAsync(g_partH[s], g_partBytes, g_partD, g_partBytes,
                              ACL_MEMCPY_DEVICE_TO_HOST, g_sC), "copy raw INT32 partials");
    CheckAcl(aclrtRecordEvent(g_done[s], g_sC), "record partials completion");
    ++g_sub;
}

extern "C" const int32_t* pearl_wait_partials(void)
{
    if (g_fin == g_sub) {
        std::cerr << "[pearl-hlc2] strip queue empty" << std::endl;
        std::exit(2);
    }
    const int s = (int)(g_fin % PEARL_PIPE_DEPTH);
    CheckAcl(aclrtSynchronizeEventWithTimeout(g_done[s], 30000), "wait for cube and D2H");
    ++g_fin;
    return g_partH[s];
}

extern "C" void* pearl_pinned_alloc(size_t n)
{
    void* q = nullptr;
    CheckAcl(aclrtMallocHost(&q, n), "allocate pinned host input");
    return q;
}

extern "C" void pearl_pinned_free(void* q) { if (q) aclrtFreeHost(q); }

extern "C" void pearl_finalize()
{
    CheckAcl(aclrtSynchronizeStream(g_sC), "finalize cube");
    CheckAcl(aclrtSynchronizeStream(g_sB), "finalize B upload");
    for (int s = 0; s < PEARL_PIPE_DEPTH; ++s) {
        aclrtDestroyEvent(g_done[s]);
        aclrtFreeHost(g_partH[s]);
    }
    for (int s = 0; s < 2; ++s) {
        aclrtFree(g_btD[s]);
        if (g_btH[s]) aclrtFreeHost(g_btH[s]);
    }
    aclrtFree(g_atD);
    aclrtFree(g_partD);
    aclrtFree(g_wsD);
    aclrtDestroyStream(g_sC);
    aclrtDestroyStream(g_sB);
}
