/* Ascend cube producer and host API. Independent cube/vector streams share
 * monotonic producer/consumer flags; production returns only the hashed hit.
 */
#include <algorithm>
#include <iostream>
#include "../src/pearl_pipeline.h"
#include "../src/prl_config.h"
#include <cstdlib>
#include <cstring>
#include <climits>
#include <vector>
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

#ifndef BUFS
#define BUFS 4
#endif
#ifndef BACKOFF
#define BACKOFF 32
#endif
#ifndef VEC2X
#define VEC2X 2
#endif
constexpr int32_t R = PRL_RANK, BN = PRL_BAND_COLS, KSTEP = PRL_RANK;
constexpr int32_t NFOLD_C = PRL_K / KSTEP;
constexpr int32_t MM_M = R, MM_N = PRL_CUBE_COLS, MM_K = KSTEP;
constexpr int32_t BANDS_PER_GROUP = MM_N / BN;
constexpr int32_t GRID = PEARL_GRID;
static_assert(PRL_K % KSTEP == 0 && MM_N % BN == 0, "invalid Cube shape");
static_assert(BUFS >= 2, "partial ring requires at least two buffers");
static_assert(VEC2X >= 1, "VEC2X must be positive");
static_assert(BACKOFF >= 0, "BACKOFF must be nonnegative");
constexpr size_t HIT_BYTES = PEARL_HIT_WORDS(VEC2X) * sizeof(uint32_t);
constexpr int32_t SLOT_ELEMS = MM_M * MM_N;
constexpr int32_t WORDS = 16;
constexpr int32_t FSTRIDE = 128;
constexpr int32_t NFLAGS = GRID * BUFS * FSTRIDE;
constexpr size_t A_BYTES = (size_t)R * PRL_K;

__aicore__ inline uint64_t Slot(int32_t lc, int32_t buf, int32_t p)
{
    return (((uint64_t)lc * BUFS + buf) * NFOLD_C + p) * SLOT_ELEMS;
}

__aicore__ inline void FlagStore(__gm__ volatile int32_t* p, int32_t v)
{
    *p = v;
    dcci((__gm__ int32_t*)p, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
}
__aicore__ inline void FlagSpinGE(__gm__ volatile int32_t* p, int32_t v)
{
    // Start with a short poll interval for near-ready buffers; BACKOFF remains
    // the cap for sustained waits. Every poll still refreshes the GM cache line.
    int32_t delay = BACKOFF < 8 ? BACKOFF : 8;
    while (true) {
        dcci((__gm__ int32_t*)p, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
        if (*p >= v) break;
        for (volatile int32_t i = 0; i < delay; ++i) {}
        if (delay < BACKOFF) delay = delay > BACKOFF / 2 ? BACKOFF : delay * 2;
    }
}

__global__ __cube__ void pearl_hlc2_cube(__gm__ uint8_t* b, __gm__ uint8_t* a, __gm__ uint8_t* part,
    __gm__ int32_t* prodF, __gm__ int32_t* consF, __gm__ uint8_t* workspace,
    AscendC::tiling::TCubeTiling tiling, int32_t groups, int32_t gridDim, int32_t strip)
{
    const int32_t lc = AscendC::GetBlockIdx();
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<int8_t> aGM, bGM;
    aGM.SetGlobalBuffer((__gm__ int8_t*)a);
    bGM.SetGlobalBuffer((__gm__ int8_t*)b);
    AscendC::GlobalTensor<int32_t> partG;
    partG.SetGlobalBuffer((__gm__ int32_t*)part);
    matmul::Matmul<matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t, false>,
                   matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t, false>,
                   matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(MM_M, MM_N, MM_K, MM_K);
    __gm__ volatile int32_t* prod = (__gm__ volatile int32_t*)prodF;
    __gm__ volatile int32_t* cons = (__gm__ volatile int32_t*)consF;
    const int32_t iterBase = strip * ((groups - lc + gridDim - 1) / gridDim);
    int32_t iter = 0;
    for (int32_t group = lc; group < groups; group += gridDim, ++iter) {
        const int32_t giter = iterBase + iter;
        const int32_t buf = giter % BUFS;
        const int32_t flag = (lc * BUFS + buf) * FSTRIDE;
        if (giter >= BUFS) {
            for (int32_t sub = 0; sub < VEC2X; ++sub)
                FlagSpinGE(&cons[sub * NFLAGS + flag], giter - BUFS + 1);
        }
        for (int32_t p = 0; p < NFOLD_C; ++p) {
            const uint64_t bOffset = ((uint64_t)p * groups + group) * MM_N * MM_K;
            mm.SetTensorA(aGM[(uint64_t)p * MM_M * MM_K], false);
            mm.SetTensorB(bGM[bOffset], false);
            mm.IterateAll(partG[Slot(lc, buf, p)]);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        FlagStore(&prod[flag], giter + 1);
    }
    mm.End();
}

extern "C" void LaunchVec(void*, void*, void*, void*, int32_t, int32_t, int32_t, void*,
                          void*, void*, void*, int32_t, int32_t);

static bool GenTiling(platform_ascendc::PlatformAscendC* plat, AscendC::tiling::TCubeTiling& t)
{
    matmul_tiling::MultiCoreMatmulTiling api(*plat);
    api.SetDim(1);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ, matmul_tiling::DataType::DT_INT8, false);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ, matmul_tiling::DataType::DT_INT8, false);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
    api.SetOrgShape(MM_M, MM_N, MM_K);
    api.SetShape(MM_M, MM_N, MM_K);
    api.SetFixSplit(MM_M, 128, MM_K);
    api.EnableBias(false);
    api.SetBufferSpace(-1, -1, -1);
    return api.GetTiling(t) != -1 && t.singleCoreM == MM_M &&
           t.singleCoreN == MM_N && t.singleCoreK == MM_K;
}

static void PackA(const int8_t* a, int8_t* nz)
{
    for (int32_t p = 0; p < NFOLD_C; ++p)
        for (int32_t k = 0; k < MM_K; k += PRL_INT8_NZ_C0)
            for (int32_t row = 0; row < R; ++row) {
                std::memcpy(nz, a + (size_t)row * PRL_K + p * MM_K + k, PRL_INT8_NZ_C0);
                nz += PRL_INT8_NZ_C0;
            }
}

static void PackB(const int8_t* b, int8_t* nz, int32_t n, int32_t paddedN)
{
    constexpr int32_t C0 = PRL_INT8_NZ_C0;
    for (int32_t p = 0; p < NFOLD_C; ++p) {
        int8_t* dst = nz + (size_t)p * MM_K * paddedN;
        for (int32_t col = 0; col < n; col += C0)
            for (int32_t k = 0; k < MM_K; ++k)
                std::memcpy(dst + (size_t)col * MM_K + k * C0,
                            b + ((size_t)p * MM_K + k) * n + col, C0);
        std::memset(dst + (size_t)n * MM_K, 0, (size_t)(paddedN - n) * MM_K);
    }
}

static aclrtStream g_sC = nullptr, g_sV = nullptr, g_sB = nullptr;
static AscendC::tiling::TCubeTiling g_tiling;
static uint8_t* g_atD[PEARL_PIPE_DEPTH] = {};
static int8_t* g_atH[PEARL_PIPE_DEPTH] = {};
// DOUBLE-BUFFER B so set_b(i+1) (repack+H2D into the back buffer) overlaps scan(i) which
// reads the live buffer. g_btLive selects the buffer the cube reads; the miner flips it per scan.
static uint8_t* g_btD[2] = {nullptr, nullptr};
static int      g_btLive = 0;
static uint8_t* g_partD = nullptr;
static uint8_t* g_tD[PEARL_PIPE_DEPTH] = {};
static uint8_t* g_wsD = nullptr;
static int32_t* g_prodF = nullptr;
static int32_t* g_consF = nullptr;
static int8_t*  g_btH[2] = {nullptr, nullptr};
static uint8_t* g_tH[PEARL_PIPE_DEPTH] = {};
static aclrtEvent g_evVdone[PEARL_PIPE_DEPTH];
static aclrtEvent g_evScanReady = nullptr;
static int64_t  g_sub = 0, g_fin = 0;   // Host strip queue counters (single submit/wait thread).
static int32_t  g_nbands = 0;
static int32_t  g_groups = 0;
static int32_t  g_grid = 0;
static int32_t  g_paddedN = 0;
static int32_t  g_n_hi = 1;
static int      g_dev = 0;

static uint32_t* g_hitResultD[PEARL_PIPE_DEPTH] = {};  // Per-slot, per-vector-block results.
static uint32_t* g_hitResultH[PEARL_PIPE_DEPTH] = {};
static uint32_t* g_keyD = nullptr;
static uint32_t* g_targetD = nullptr;
static uint32_t* g_keyH = nullptr;
static uint32_t* g_targetH = nullptr;

static void CheckAcl(aclError e, const char* op)
{
    if (e != ACL_SUCCESS) {
        std::cerr << "[pearl-hlc2] " << op << " failed: " << e << std::endl;
        exit(2);
    }
}

extern "C" int pearl_init(int device_id, int nbands)
{
    if (nbands <= 0 || nbands > (INT_MAX - MM_N) / BN) return -1;
    aclError e = aclInit(nullptr);
    if (e != ACL_SUCCESS && e != ACL_ERROR_REPEAT_INITIALIZE) {
        std::cout << "[pearl-hlc2] aclInit failed: " << e << std::endl; return (int)e;
    }
    g_dev = device_id;
    aclrtSetDevice(device_id);
    aclrtCreateStream(&g_sC); aclrtCreateStream(&g_sV); aclrtCreateStream(&g_sB);
    CheckAcl(aclrtCreateEventExWithFlag(&g_evScanReady, ACL_EVENT_SYNC), "create scan-ready event");
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!GenTiling(plat, g_tiling)) {
        std::cerr << "[pearl-hlc2] 4096-column AB-NZ tiling failed" << std::endl;
        return -1;
    }
    size_t wsSize = (size_t)plat->GetLibApiWorkSpaceSize();
    g_nbands = nbands;
    g_groups = (nbands + BANDS_PER_GROUP - 1) / BANDS_PER_GROUP;
    g_grid = std::min(g_groups, GRID);
    g_paddedN = g_groups * MM_N;
    size_t btSize = (size_t)g_paddedN * PRL_K;
    size_t partSize = (size_t)g_grid * BUFS * NFOLD_C * SLOT_ELEMS * sizeof(int32_t);
    aclrtMalloc((void**)&g_btD[0], btSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&g_btD[1], btSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&g_wsD, wsSize, ACL_MEM_MALLOC_HUGE_FIRST);
    CheckAcl(aclrtMalloc((void**)&g_partD, partSize, ACL_MEM_MALLOC_HUGE_FIRST), "allocate AB-NZ partial ring");
    aclrtMalloc((void**)&g_prodF, NFLAGS * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    CheckAcl(aclrtMalloc((void**)&g_consF, VEC2X * NFLAGS * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST), "allocate consumer flags");
    for (int s = 0; s < PEARL_PIPE_DEPTH; ++s) {
        CheckAcl(aclrtMalloc((void**)&g_atD[s], A_BYTES, ACL_MEM_MALLOC_HUGE_FIRST), "allocate device A NZ");
        CheckAcl(aclrtMallocHost((void**)&g_atH[s], A_BYTES), "allocate pinned A NZ");
        aclrtCreateEvent(&g_evVdone[s]);
    }
    aclrtMallocHost((void**)&g_btH[0], btSize); // pinned: async H2D overlaps scan
    aclrtMallocHost((void**)&g_btH[1], btSize);

    for (int hs = 0; hs < PEARL_PIPE_DEPTH; ++hs) {
        CheckAcl(aclrtMalloc((void**)&g_hitResultD[hs], HIT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST), "allocate hit results");
        CheckAcl(aclrtMallocHost((void**)&g_hitResultH[hs], HIT_BYTES), "allocate pinned hit results");
        // Initialize padding once; subsequent kernels overwrite every live record.
        CheckAcl(aclrtMemset(g_hitResultD[hs], HIT_BYTES, 0, HIT_BYTES), "initialize hit-result padding");
    }
    aclrtMalloc((void**)&g_keyD, 32, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&g_targetD, 32, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&g_keyH, 32);
    aclrtMallocHost((void**)&g_targetH, 32);

    std::cout << "[pearl-hlc2] init dev=" << device_id << " nbands=" << nbands
              << " AB-NZ columns=" << MM_N << " groups=" << g_groups << " active_cube=" << g_grid
              << " BUFS=" << BUFS << " VEC2X=" << VEC2X << " slots=" << partSize / (1 << 20)
              << "MB ws=" << wsSize << std::endl;
    return 0;
}

// set_b split for the pipelined path:
//   pearl_set_b_slot(B,N,slot) — repack + ASYNC H2D into back buffer `slot` (on g_sB, its own
//     stream + pinned host), then sync g_sB. Runs in the prep thread, OVERLAPS the live scan
//     (which reads g_btD[g_btLive], a DIFFERENT slot). Does NO flag/counter reset (the live scan
//     is using them) — that is deferred to pearl_use_b on the main thread between scans.
//   pearl_use_b(slot) — make `slot` the live buffer + reset the monotonic flags/counters.
//     Call AFTER the prev scan has drained.
extern "C" void pearl_set_b_slot(const int8_t* B_host, int N, int slot)
{
    aclrtSetDevice(g_dev);
    if (N != g_nbands * BN || slot < 0 || slot >= 2) {
        std::cerr << "[pearl-hlc2] invalid B dimensions or slot" << std::endl;
        exit(2);
    }
    const size_t bytes = (size_t)g_paddedN * PRL_K;
    PackB(B_host, g_btH[slot], N, g_paddedN);
    CheckAcl(aclrtMemcpyAsync(g_btD[slot], bytes, g_btH[slot], bytes, ACL_MEMCPY_HOST_TO_DEVICE, g_sB), "upload B NZ");
    CheckAcl(aclrtSynchronizeStream(g_sB), "complete B NZ upload");
}

// The prep path supplies compact [fold][N/32][128][32] data.
extern "C" void pearl_set_b_nz_slot(const int8_t* b_packed, int slot)
{
    aclrtSetDevice(g_dev);
    if (slot < 0 || slot >= 2) {
        std::cerr << "[pearl-hlc2] invalid B NZ slot" << std::endl;
        exit(2);
    }
    const int8_t* source = b_packed;
    const size_t foldBytes = (size_t)g_nbands * BN * MM_K;
    const size_t paddedFoldBytes = (size_t)g_paddedN * MM_K;
    if (foldBytes != paddedFoldBytes) {
        source = g_btH[slot];
        for (int32_t p = 0; p < NFOLD_C; ++p) {
            int8_t* dst = g_btH[slot] + p * paddedFoldBytes;
            std::memcpy(dst, b_packed + p * foldBytes, foldBytes);
            std::memset(dst + foldBytes, 0, paddedFoldBytes - foldBytes);
        }
    }
    const size_t bytes = paddedFoldBytes * NFOLD_C;
    CheckAcl(aclrtMemcpyAsync(g_btD[slot], bytes, source, bytes, ACL_MEMCPY_HOST_TO_DEVICE, g_sB), "upload packed B NZ");
    CheckAcl(aclrtSynchronizeStream(g_sB), "complete packed B NZ upload");
}
extern "C" void pearl_use_b(int slot)
{
    if (slot < 0 || slot >= 2 || g_sub != g_fin) {
        std::cerr << "[pearl-hlc2] use_b requires a valid slot and a drained strip queue" << std::endl;
        exit(2);
    }
    // Scan boundary only: all vector completion events have been consumed.
    // Previous vector work is done; cube work and resets stay ordered on
    // g_sC. set_key_target publishes reset/key readiness to g_sV via event.
    CheckAcl(aclrtMemsetAsync(g_consF, VEC2X * NFLAGS * sizeof(int32_t), 0, VEC2X * NFLAGS * sizeof(int32_t), g_sC), "reset consumer flags");
    CheckAcl(aclrtMemsetAsync(g_prodF, NFLAGS * sizeof(int32_t), 0, NFLAGS * sizeof(int32_t), g_sC), "reset producer flags");

    g_btLive = slot;
    g_sub = g_fin = 0;
}
extern "C" void pearl_set_b(const int8_t* B_host, int N)
{
    pearl_set_b_slot(B_host, N, 0);
    pearl_use_b(0);
}

static void EnsureTranscriptBuffers()
{
    const size_t tSizeB = (size_t)g_nbands * WORDS * BN * 4;
    for (int s = 0; s < PEARL_PIPE_DEPTH; ++s) {
        if (!g_tD[s]) aclrtMalloc((void**)&g_tD[s], tSizeB, ACL_MEM_MALLOC_HUGE_FIRST);
        if (!g_tH[s]) aclrtMallocHost((void**)&g_tH[s], tSizeB);
    }
}

/*
 * Pipelined path. All per-strip device work is queued async; flags are monotonic
 * across strips (iterBase = strip * itersPerCore), so there is nothing to reset per strip
 * and no per-strip cross-stream events. Cube and Vector overlap via the
 * group ring while the host packs and uploads A for the next strip.
 */
static void pearl_strip_submit_impl(const int8_t* A_host, int emitTranscript)
{
    // Never overwrite an unread result/event. Submit and wait share one host thread.
    if (g_sub - g_fin >= PEARL_PIPE_DEPTH) {
        std::cerr << "[pearl-hlc2] strip queue full; wait and consume result before submit" << std::endl;
        exit(2);
    }
    // Device already bound on this thread (init / use_b / set_key); skip SetDevice on the hot path.
    const size_t tSizeB = (size_t)g_nbands * WORDS * BN * 4;
    const int s = (int)(g_sub % PEARL_PIPE_DEPTH);
    // Device flags and hit encoding use signed int32 arithmetic.
    const int64_t laneIters = ((int64_t)g_groups + g_grid - 1) / g_grid;
    const int64_t tiles = (int64_t)g_nbands * g_n_hi;
    if (g_sub >= INT_MAX / laneIters || g_sub >= INT_MAX / tiles) {
        std::cerr << "[pearl-hlc2] strip generation limit reached; drain and start a new scan" << std::endl;
        exit(2);
    }
    const int32_t strip = (int32_t)g_sub;

    if (emitTranscript) EnsureTranscriptBuffers();

    PackA(A_host, g_atH[s]);
    CheckAcl(aclrtMemcpyAsync(g_atD[s], A_BYTES, g_atH[s], A_BYTES, ACL_MEMCPY_HOST_TO_DEVICE, g_sC), "upload A NZ");
    pearl_hlc2_cube<<<g_grid, nullptr, g_sC>>>(g_btD[g_btLive], g_atD[s], g_partD, g_prodF, g_consF,
                                               g_wsD, g_tiling, g_groups, g_grid, strip);
    LaunchVec(g_partD, emitTranscript ? g_tD[s] : nullptr, g_prodF, g_consF, g_nbands, g_grid,
              strip, g_sV, g_hitResultD[s], g_keyD, g_targetD, g_n_hi,
              emitTranscript ? 1 : 0);

    CheckAcl(aclrtMemcpyAsync(g_hitResultH[s], HIT_BYTES, g_hitResultD[s], HIT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST, g_sV), "copy hit results");
    if (emitTranscript) {
        aclrtMemcpyAsync(g_tH[s], tSizeB, g_tD[s], tSizeB, ACL_MEMCPY_DEVICE_TO_HOST, g_sV);
    }
    CheckAcl(aclrtRecordEvent(g_evVdone[s], g_sV), "record vector completion");
    ++g_sub;
}

extern "C" void pearl_strip_submit(const int8_t* A_host)
{
    pearl_strip_submit_impl(A_host, 1);
}

extern "C" void pearl_strip_submit_fast(const int8_t* A_host)
{
    pearl_strip_submit_impl(A_host, 0);
}

extern "C" void pearl_set_key_target(const uint32_t* key_host, const uint32_t* target_host)
{
    aclrtSetDevice(g_dev);
    std::memcpy(g_keyH, key_host, 32);
    std::memcpy(g_targetH, target_host, 32);
    CheckAcl(aclrtMemcpyAsync(g_keyD, 32, g_keyH, 32, ACL_MEMCPY_HOST_TO_DEVICE, g_sC), "upload key");
    CheckAcl(aclrtMemcpyAsync(g_targetD, 32, g_targetH, 32, ACL_MEMCPY_HOST_TO_DEVICE, g_sC), "upload target");
    CheckAcl(aclrtRecordEvent(g_evScanReady, g_sC), "record scan readiness");
    CheckAcl(aclrtStreamWaitEvent(g_sV, g_evScanReady), "vector waits for flags/key/target");
}

// tiles per band = R/nrows (n_hi). Must be set before scanning so the vec kernel hashes all
// n_hi tiles per band and the hit index encodes/decodes consistently with miner.c.
extern "C" void pearl_set_nhi(int n_hi) {
    // Production BLAKE3 is Vector64-only; never silently run scalar hashes.
    // The supported pool profiles use nrows=2, hence n_hi=128/2=64.
    if (n_hi != BN) {
        std::cerr << "[pearl-hlc2] BLAKE3 Vector64 requires n_hi=64 (got "
                  << n_hi << "); no scalar hash fallback is available" << std::endl;
        exit(2);
    }
    g_n_hi = n_hi;
}

extern "C" int pearl_get_hit_result(int* hit_strip, int* hit_tile)
{
    // Waiting on the vector completion event also completes this slot's result D2H.
    // The last completed strip is always in slot (g_fin - 1) % PEARL_PIPE_DEPTH.
    if (g_fin == 0) return 0;
    const int hs = (int)((g_fin - 1) % PEARL_PIPE_DEPTH);
    uint32_t encoded_tile = 0;
    if (pearl_reduce_hits(g_hitResultH[hs], g_grid * VEC2X, &encoded_tile)) {
        // Keep the tile index in the vector kernel's [hi][band] encoding;
        // miner.c decodes it into row and column offsets.
        int32_t tiles = g_nbands * g_n_hi;
        *hit_strip = (int)(encoded_tile / tiles);
        *hit_tile  = (int)(encoded_tile % tiles);
        return 1;
    }
    return 0;
}

extern "C" void pearl_strip_wait(uint32_t* trans_out)
{
    size_t tSize = (size_t)g_nbands * WORDS * BN * 4;
    const int s = (int)(g_fin % PEARL_PIPE_DEPTH);
    // self-diagnosing: on hang dump flags and die loudly instead of silently mining garbage
    if (aclrtSynchronizeEventWithTimeout(g_evVdone[s], 30000) != ACL_SUCCESS) {
        std::vector<int32_t> pf(NFLAGS), cf(VEC2X * NFLAGS);
        aclrtMemcpy(pf.data(), NFLAGS * 4, g_prodF, NFLAGS * 4, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(cf.data(), VEC2X * NFLAGS * 4, g_consF, VEC2X * NFLAGS * 4, ACL_MEMCPY_DEVICE_TO_HOST);
        std::cout << "[pearl-hlc2] HANG sub=" << g_sub << " fin=" << g_fin << std::endl;
        for (int lc = 0; lc < g_grid; ++lc) {
            std::cout << "lc" << lc;
            for (int b = 0; b < BUFS; ++b)
                std::cout << "  p" << pf[(lc * BUFS + b) * FSTRIDE] << "/c" << cf[(lc * BUFS + b) * FSTRIDE];
            std::cout << std::endl;
        }
        exit(2);
    }
    std::memcpy(trans_out, g_tH[s], tSize);
    ++g_fin;
}

// Production wait: only waits for completion; no transcript pointer/copy is involved.
extern "C" void pearl_strip_wait_done(void)
{
    const int s = (int)(g_fin % PEARL_PIPE_DEPTH);
    if (aclrtSynchronizeEventWithTimeout(g_evVdone[s], 30000) != ACL_SUCCESS) {
        std::cout << "[pearl-hlc2] HANG sub=" << g_sub << " fin=" << g_fin << std::endl;
        exit(2);
    }
    ++g_fin;
}

// Transcript pointer stays valid until this slot is reused after PEARL_PIPE_DEPTH submits.
extern "C" const uint32_t* pearl_strip_wait_ptr(void)
{
    const int s = (int)(g_fin % PEARL_PIPE_DEPTH);
    if (aclrtSynchronizeEventWithTimeout(g_evVdone[s], 30000) != ACL_SUCCESS) {
        std::cout << "[pearl-hlc2] HANG sub=" << g_sub << " fin=" << g_fin << std::endl;
        exit(2);
    }
    ++g_fin;
    return (const uint32_t*)g_tH[s];
}

extern "C" void pearl_mine_strip(const int8_t* A_host, uint32_t* trans_out)
{
    pearl_strip_submit(A_host);
    pearl_strip_wait(trans_out);
}

extern "C" void* pearl_pinned_alloc(size_t n){ void* q=nullptr; aclrtMallocHost(&q, n); return q; }
extern "C" void pearl_pinned_free(void* q){ if(q) aclrtFreeHost(q); }

extern "C" void pearl_finalize()
{
    if (g_sC) CheckAcl(aclrtSynchronizeStream(g_sC), "finalize cube");
    if (g_sV) CheckAcl(aclrtSynchronizeStream(g_sV), "finalize vector");
    if (g_sB) CheckAcl(aclrtSynchronizeStream(g_sB), "finalize B upload");
    for (int s = 0; s < PEARL_PIPE_DEPTH; ++s) {
        if (g_atD[s]) aclrtFree(g_atD[s]);
        if (g_atH[s]) aclrtFreeHost(g_atH[s]);
        if (g_tD[s]) aclrtFree(g_tD[s]);
        if (g_tH[s]) aclrtFreeHost(g_tH[s]);
        if (g_evVdone[s]) aclrtDestroyEvent(g_evVdone[s]);
    }
    // B remains double buffered independently of the strip queue depth.
    for (int s = 0; s < 2; ++s) {
        if (g_btD[s]) aclrtFree(g_btD[s]);
        if (g_btH[s]) aclrtFreeHost(g_btH[s]);
    }
    if (g_evScanReady) aclrtDestroyEvent(g_evScanReady);
    if (g_partD) aclrtFree(g_partD);
    if (g_wsD) aclrtFree(g_wsD);
    if (g_prodF) aclrtFree(g_prodF);
    if (g_consF) aclrtFree(g_consF);
    if (g_sC) aclrtDestroyStream(g_sC);
    if (g_sV) aclrtDestroyStream(g_sV);
    if (g_sB) aclrtDestroyStream(g_sB);

    for (int hs = 0; hs < PEARL_PIPE_DEPTH; ++hs) {
        if (g_hitResultD[hs]) aclrtFree(g_hitResultD[hs]);
        if (g_hitResultH[hs]) aclrtFreeHost(g_hitResultH[hs]);
    }
    if (g_keyD) aclrtFree(g_keyD);
    if (g_targetD) aclrtFree(g_targetD);
    if (g_keyH) aclrtFreeHost(g_keyH);
    if (g_targetH) aclrtFreeHost(g_targetH);
}
